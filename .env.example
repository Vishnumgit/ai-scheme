# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheme_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scheme_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheme_db

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="AI-Driven Scheme Matching for Marginalized Entrepreneurs"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Ingestion & Seed Configuration
SEED_ON_STARTUP=false

# AI & Embedding Providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=gemini
AI_EXPLANATION_ENABLED=false
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Public Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
